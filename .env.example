# Copy this file to .env and fill in what you use. Secrets only.
# Which provider is used (database, storage, AI model, speech) is chosen by name in backend/app/config.py.
# With nothing set, the app runs on a local SQLite file in data/.

# Postgres / Supabase database, used when DATABASE = "postgres" in config.py
# (Supabase: Project Settings -> Database -> Connection string -> URI, "Session pooler")
DATABASE_URL=

# Supabase storage, used when STORAGE = "supabase" in config.py (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=clinic-documents

# Address people open the app on (used in emailed links)
APP_URL=http://localhost:8050

# Email for invites and password resets (any SMTP provider, e.g. Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Clinic time zone (default India)
CLINIC_TZ=Asia/Kolkata

# Optional AI
GEMINI_API_KEY=
# Live dictation (Deepgram). Empty: the browser's own speech recognition is used.
DEEPGRAM_API_KEY=
